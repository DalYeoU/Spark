# Created by https://www.toptal.com/developers/gitignore/api/unrealengine
# Edit at https://www.toptal.com/developers/gitignore?templates=unrealengine

### UnrealEngine ###
# Visual Studio 2015 user specific files
.vs/
.idea/
.vsconfig
*.sln.DotSettings.user
.agents/
AGENTS.md
CLAUDE.md

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.vksample
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db

*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Visual Studio cache
.vs/
*.ipch

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

### UnrealEngine Patch ###
# Don't ignore icon and splash images for mobile app
!Build/IOS/Resources/
Build/IOS/Resources/*
!Build/IOS/Resources/Graphics/
Build/IOS/Resources/Graphics/*
!Build/IOS/Resources/Graphics/*.png
!Build/Android/res/
Build/Android/res/*
!Build/Android/res/*/
Build/Android/res/*/*
!Build/Android/res/*/*.png
# Ignore plugins binaries on deep subfolders
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# Unreal Engine 5.4+ Zen Storage VFS Cache
Data/
!Source/Spark/Data

# FoxDen 앱의 로컬 설정 파일 폴더
.foxden/

# TIL용 로그 제외
Docs/TIL

# 로봇 이미지
Docs/Robot_Concept_art

### Custom: LFS 미지원 환경이라 대용량 바이너리는 git 밖에서 관리 ###
# Content는 클라우드(OneDrive 등)로 별도 백업, git에는 Source/Config/문서만
Content/
